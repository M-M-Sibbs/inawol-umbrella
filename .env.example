# === Turso database ===
# Create a DB at https://turso.tech, then copy its URL and a token here.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# === Admin dashboard ===
# Generate the hash with:  npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# (Optional) Move the admin off the default /dashboard path for extra obscurity.
# ADMIN_PATH=/dashboard-x9k2p

# === Paynow (EcoCash / InnBucks / OMari) ===
# Get these from your Paynow merchant dashboard: https://www.paynow.co.zw
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Must be your LIVE https URLs once deployed:
PAYNOW_RESULT_URL=https://your-site.vercel.app/api/paynow/callback
PAYNOW_RETURN_URL=https://your-site.vercel.app/tutoring/return

# === Cloudflare Stream (secure lesson videos) ===
# Account ID + an API token with Stream:Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# Signing keys make videos private (playback only via short-lived signed tokens).
# Create once:  POST https://api.cloudflare.com/client/v4/accounts/{id}/stream/keys
# Store the returned key id, and the JWK base64-encoded.
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_JWK=

# === Optional: media storage on Vercel Blob (project images) ===
BLOB_READ_WRITE_TOKEN=
